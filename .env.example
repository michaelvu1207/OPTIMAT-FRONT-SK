# =============================================================================
# OPTIMAT-FRONT Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# API Mode Selection
# -----------------------------------------------------------------------------
# Select the migration backend. Production should move from supabase to aws only
# after the validation and write-fence cutover gates pass.
VITE_API_BACKEND=supabase
VITE_AWS_API_URL=https://your-api-id.execute-api.us-west-1.amazonaws.com

# -----------------------------------------------------------------------------
# Supabase Configuration (required when VITE_USE_SUPABASE=true)
# -----------------------------------------------------------------------------
# Your Supabase project URL
VITE_SUPABASE_URL=https://htjohidcoyfuwfjecazu.supabase.co

# Your Supabase publishable key (safe to expose in frontend)
VITE_SUPABASE_ANON_KEY=your_temporary_supabase_publishable_key

# -----------------------------------------------------------------------------
# Direct API Configuration (used when VITE_USE_SUPABASE=false)
# -----------------------------------------------------------------------------
# Base API host for provider service (no trailing slash)
VITE_API_URL=http://localhost:8001

# Providers API prefix (match FastAPI PROVIDERS_API_PREFIX)
# Leave empty for direct FastAPI access, use /api-providers for nginx proxy
VITE_API_PREFIX=/api-providers

# Chat API base URL (direct port in dev; proxy adds /api-chat in prod)
VITE_CHAT_API_URL=http://localhost:8002

# -----------------------------------------------------------------------------
# Server-side Function Secrets (do not expose with VITE_)
# -----------------------------------------------------------------------------
# Used by Supabase Edge Functions or AWS Lambda for chatbot voice-to-text.
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
