# =============================================================================
# OPTIMAT-FRONT Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Backend Selection
# -----------------------------------------------------------------------------
# Which backend to use: 'supabase' or 'aws' (default: supabase)
VITE_API_BACKEND=supabase

# -----------------------------------------------------------------------------
# Supabase Configuration (required when VITE_API_BACKEND=supabase)
# -----------------------------------------------------------------------------
# Your Supabase project URL
VITE_SUPABASE_URL=https://htjohidcoyfuwfjecazu.supabase.co

# Your Supabase anonymous/public key (safe to expose in frontend)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# -----------------------------------------------------------------------------
# AWS Configuration (required when VITE_API_BACKEND=aws)
# -----------------------------------------------------------------------------
# API Gateway URL (no trailing slash)
VITE_AWS_API_URL=https://your-api-id.execute-api.us-west-1.amazonaws.com

# API Gateway API key (optional, leave empty if not using API key auth)
VITE_AWS_API_KEY=

# -----------------------------------------------------------------------------
# Legacy Direct API Configuration (no longer used)
# -----------------------------------------------------------------------------
# VITE_API_URL=http://localhost:8001
# VITE_API_PREFIX=/api-providers
# VITE_CHAT_API_URL=http://localhost:8002
