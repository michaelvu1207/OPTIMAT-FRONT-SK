# =============================================================================
# OPTIMAT-FRONT Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# API Mode Selection
# -----------------------------------------------------------------------------
# Production uses the public AWS API. No browser API key is required.
VITE_API_BACKEND=aws
VITE_AWS_API_URL=https://api.optimat.us

# -----------------------------------------------------------------------------
# Direct API Configuration (used when VITE_USE_SUPABASE=false)
# -----------------------------------------------------------------------------
# Base API host for provider service (no trailing slash)
VITE_API_URL=http://localhost:8001

# Providers API prefix (match FastAPI PROVIDERS_API_PREFIX)
# Leave empty for direct FastAPI access, use /api-providers for nginx proxy
VITE_API_PREFIX=/api-providers

# Chat API base URL (direct port in dev; proxy adds /api-chat in prod)
VITE_CHAT_API_URL=http://localhost:8002

# -----------------------------------------------------------------------------
# Server-side Function Secrets (do not expose with VITE_)
# -----------------------------------------------------------------------------
# Used only by compatible local/server runtimes. Production transcription uses
# Amazon Transcribe through the AWS Lambda application role.
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
